# Supabase Auth (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Prisma → Supabase PostgreSQL
DATABASE_URL=postgresql://user:password@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&statement_cache_size=0
DIRECT_URL=postgresql://user:password@db.your-project.supabase.co:5432/postgres

# Application URLs
NEXT_PUBLIC_SITE_URL=https://heritogo.vercel.app
NEXT_PUBLIC_APP_URL=https://heritogo.codorah.com

# Backend FastAPI & Chatbot
FASTAPI_URL=https://heritogo-backend.fastapicloud.dev
NEXT_PUBLIC_CHATBOT_API_URL=https://heritogo-backend.fastapicloud.dev/chatbot/api/v1/chat
API_SECRET_KEY=your_secret_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google AdSense (PWA HeriTogo)
# Format obligatoire: ca-pub-XXXXXXXXXXXXXXXX (ex: ca-pub-3944525312929685)
# Si vide ou désactivé, aucun script AdSense ni encart publicitaire ne sera chargé.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-3944525312929685
NEXT_PUBLIC_ADS_ENABLED=true
